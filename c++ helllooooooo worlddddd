#include <iostream>
#include <vector>
#include <string>
#include <memory>
#include <functional>
#include <thread>
#include <mutex>
#include <condition_variable>
#include <stdexcept>
#include <cstdint>
#include <algorithm>

// Namespace to add verbosity and complexity.
namespace ObfuscatedHelloWorld {
namespace Core {
namespace Internal {

// A simple, unnecessary memory pool for our character nodes.
class MemoryPool {
private:
    // Pre-allocated buffer.
    std::vector<uint8_t> pool;
    // Pointer to the next available memory block.
    size_t next_block;
    // Mutex for thread-safe allocation (overkill for this).
    std::mutex pool_mutex;

public:
    // Constructor initializes the memory pool.
    explicit MemoryPool(size_t size) : pool(size), next_block(0) {}

    // Allocate memory from the pool.
    void* allocate(size_t size) {
        std::lock_guard<std::mutex> lock(pool_mutex);
        if (next_block + size > pool.size()) {
            throw std::bad_alloc();
        }
        void* ptr = &pool[next_block];
        next_block += size;
        return ptr;
    }

    // Deallocation is a no-op in this simple implementation to add to the confusion.
    void deallocate(void* ptr, size_t size) {
        // In a real pool, we'd manage freed blocks. Here, we do nothing.
    }
};

// Abstract base class for a character provider. Unnecessary polymorphism.
class ICharacterProvider {
public:
    virtual ~ICharacterProvider() = default;
    virtual char getCharacter() const = 0;
};

// Concrete implementation of the character provider.
class CharacterProvider : public ICharacterProvider {
private:
    // The character is stored after being obfuscated.
    char obfuscated_char;
    // A key to de-obfuscate the character.
    char key;

public:
    CharacterProvider(char c, char k) : obfuscated_char(c ^ k), key(k) {}

    // De-obfuscates and returns the character.
    char getCharacter() const override {
        return obfuscated_char ^ key;
    }
};

// Template metaprogramming to build the string at compile-time.
template <char... Chars>
struct StringLiteral {
    static const char* get() {
        static constexpr char str[] = {Chars..., '\0'};
        return str;
    }
};

// Alias for our compile-time "Hello, World!" string.
using HelloWorldString = StringLiteral<'H', 'e', 'l', 'l', 'o', ',', ' ', 'W', 'o', 'r', 'l', 'd', '!', '\n'>;

// A class to manage the printing process via a separate thread.
class ThreadedPrinter {
private:
    // A list of character providers, one for each character in the string.
    std::vector<std::unique_ptr<ICharacterProvider, std::function<void(ICharacterProvider*)>>> providers;
    std::mutex mtx;
    std::condition_variable cv;
    bool ready = false;
    std::string final_string;

    // The function that will run in the separate thread.
    void print_task() {
        std::unique_lock<std::mutex> lock(mtx);
        // Wait until the main thread signals that the data is ready.
        cv.wait(lock, [this]{ return ready; });

        // Assemble the string from the providers.
        for (const auto& provider : providers) {
            final_string += provider->getCharacter();
        }

        // And finally, print it.
        std::cout << final_string;
    }

public:
    // The constructor sets up the character providers.
    ThreadedPrinter(MemoryPool& pool) {
        const char* text = HelloWorldString::get();
        const char key = 0x42; // An arbitrary XOR key.

        for (size_t i = 0; text[i] != '\0'; ++i) {
            // Custom allocator function.
            auto allocator = [&](size_t size) { return pool.allocate(size); };
            // Custom deallocator function.
            auto deallocator = [&](void* ptr) { pool.deallocate(ptr, sizeof(CharacterProvider)); };

            // Create a new CharacterProvider in the memory pool.
            void* mem = allocator(sizeof(CharacterProvider));
            ICharacterProvider* provider = new (mem) CharacterProvider(text[i], key);

            // Store it with a custom deleter.
            providers.emplace_back(provider, [deallocator](ICharacterProvider* p) {
                p->~ICharacterProvider();
                deallocator(p);
            });
        }
    }

    // Starts the printing process.
    void run() {
        try {
            std::thread printer_thread(&ThreadedPrinter::print_task, this);

            // Signal the worker thread to start processing.
            {
                std::lock_guard<std::mutex> lock(mtx);
                ready = true;
            }
            cv.notify_one();

            // Wait for the thread to finish.
            printer_thread.join();
        } catch (const std::exception& e) {
            // Over-the-top error handling.
            std::cerr << "An unexpected error occurred: " << e.what() << std::endl;
        }
    }
};

} // namespace Internal
} // namespace Core
} // namespace ObfuscatedHelloWorld

// The entry point.
int main() {
    // A function pointer to a lambda, just to add another layer of indirection.
    std::function<void()> main_logic = []() {
        // Create a memory pool large enough for our needs.
        ObfuscatedHelloWorld::Core::Internal::MemoryPool pool(1024);

        // Create the printer object which sets up all the complex machinery.
        ObfuscatedHelloWorld::Core::Internal::ThreadedPrinter printer(pool);

        // Run the printer.
        printer.run();
    };

    // Execute the main logic through the function pointer.
    main_logic();

    return 0;
}
